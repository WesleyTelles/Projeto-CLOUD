# Copie para .env e preencha. O arquivo .env NUNCA vai para o Git.
# Valores abaixo são FALSOS (exemplo).

# PostgreSQL local:
# DATABASE_URL=postgres://app_mural:senha-falsa@localhost:5432/mural
# Azure Database for PostgreSQL (senha com caractere especial: codifique na URL, ex.: @ vira %40):
DATABASE_URL=postgres://USUARIO:SENHA@SERVIDOR.postgres.database.azure.com:5432/BANCO

# SSL com o banco: true (valida certificado) | no-verify (não valida) | vazio (sem SSL, só local)
DB_SSL=true

# Porta local (no App Service a porta vem na variável PORT, definida pela Azure)
PORT=3000
